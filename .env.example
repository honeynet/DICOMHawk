# DICOMHawk runtime configuration.

# Deception profile: empty = generic default, "fujifilm", or an absolute path to a mounted custom YAML.
DICOMHAWK_PROFILE=

# AE Title override. Empty = use the profile's AE title; set only to force a different one.
DICOMHAWK_AE_TITLE=

# Comma-separated list of ports the honeypot listens on inside the container.
# The host-side publishing in docker-compose.yml must map onto these.
DICOMHAWK_PORTS=104

# Site-specific web-tier hostname emitted as X-Backendserver by the Fujifilm profile.
# Change this per deployment so multiple honeypots don't share an obvious static fingerprint.
DICOMHAWK_BACKEND_SERVER=SYNWEB01

# Public origin when TLS is terminated by a reverse proxy; keeps generated OIDC
# redirect_uri values on the real external scheme/hostname rather than backend HTTP.
# DICOMHAWK_PUBLIC_BASE_URL=https://pacs.example.org

# Container storage paths, read by both seed and serve (typer envvar). Empty DB = in-memory.
DICOMHAWK_TRACES=/opt/dicomhawk/storage
DICOMHAWK_DB=/opt/dicomhawk/storage/dicomhawk.db

# Web ports (only used if the profile has kind: pacs and web.enabled). The host-side
# publishing in docker-compose.yml must map onto these.
DICOMHAWK_WEB_PORT=8080
DICOMHAWK_OPERATOR_PORT=8081

# DICOMweb ports are NOT set here — they are part of the profile's device fingerprint, defined
# in the profile YAML (dicomweb.services). The fujifilm profile uses the real Synapse ports
# 9080 (WADO-URI) / 10080 (QIDO-RS) / 12080 (WADO-RS) / 13080 (STOW-RS); generic-pacs uses 8042
# (/dicom-web). The supplied docker-compose.yml publishes both profile layouts; only the active
# profile binds its declared listeners.

# Bind address for the operator API *inside the container*. Must be 0.0.0.0 — a container's
# 127.0.0.1 is unreachable via Docker port publishing; loopback-only comes from docker-compose.yml's host-side mapping instead.
DICOMHAWK_OPERATOR_HOST=0.0.0.0
