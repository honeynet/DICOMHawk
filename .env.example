# DICOMHawk runtime configuration.

# Logs go to $DICOMHAWK_DATA_DIR/logs, installer-generated profiles to $DICOMHAWK_DATA_DIR/profiles.
DICOMHAWK_DATA_DIR=${HOME}/data/dicomhawk

# Deception profile: empty = generic default, "fujifilm", or an absolute path to a mounted custom YAML.
DICOMHAWK_PROFILE=

# AE Title override. Empty = use the profile's AE title; set only to force a different one.
DICOMHAWK_AE_TITLE=

# Internal DIMSE ports; Compose must publish the same ports.
DICOMHAWK_PORTS=104

# Site-specific Fujifilm X-Backendserver value; change it per deployment.
DICOMHAWK_BACKEND_SERVER=SYNWEB01

# DICOMHAWK_PUBLIC_BASE_URL=https://pacs.example.org  # OIDC origin behind TLS proxy

# Overrides the profile's Secure cookie flag; leave false unless TLS terminates in front.
DICOMHAWK_SECURE_COOKIES=false

# Container storage paths for seed and serve; keep the DB off the flood-prone traces volume.
DICOMHAWK_TRACES=/opt/dicomhawk/storage
DICOMHAWK_DB=/opt/dicomhawk/state/dicomhawk.db

# Static analysis of captured payloads; the DB needs a writable volume (see docs/analysis.md).
DICOMHAWK_ANALYSIS=true
DICOMHAWK_ANALYSIS_DB=/opt/dicomhawk/state/analysis.db
# DICOMHAWK_ANALYSIS_RULES=  # optional: path to a mounted directory of extra .yar files
# DICOMHAWK_ANALYSIS_TIMEOUT=10.0       # hard wall-clock seconds per job
# DICOMHAWK_ANALYSIS_MAX_BYTES=67108864 # bounded bytes read/extracted per capture
# DICOMHAWK_ANALYSIS_QUEUE_SIZE=256     # wake-up queue only; the DB remains authoritative

# Browser fingerprints in their own store (see docs/fingerprinting.md).
DICOMHAWK_FINGERPRINT=true
DICOMHAWK_FINGERPRINT_DB=/opt/dicomhawk/state/fingerprint.db
DICOMHAWK_FINGERPRINT_MAX_BYTES=65536
DICOMHAWK_FINGERPRINT_MAX_PER_SESSION=20
DICOMHAWK_FINGERPRINT_MAX_PER_IP=500

# Internal PACS web ports; Compose must publish the same ports.
DICOMHAWK_WEB_PORT=8080
DICOMHAWK_OPERATOR_PORT=8081

# DICOMweb ports come from profile YAML; Compose publishes both built-in layouts.

# Containers bind the operator API publicly; Compose restricts its host port to loopback.
DICOMHAWK_OPERATOR_HOST=0.0.0.0

# Optional operator password/Bearer token; use a strong value outside host loopback.
# Compose passes this to the operator service only, never to the attacker-facing containers.
DICOMHAWK_OPERATOR_TOKEN=

# Exact TLS reverse-proxy IP; unset unless direct backend access is blocked and the proxy overwrites X-Forwarded-For.
DICOMHAWK_TRUSTED_PROXY=

# Guided-seeding defaults. Replace the honeytoken URL with one you monitor before exposure.
DICOMHAWK_SEED_COLLECTION=TCGA-LUAD
DICOMHAWK_SEED_MODALITY=CT
DICOMHAWK_SEED_MAX_SERIES=3
DICOMHAWK_SEED_MAX_IMAGES=30
DICOMHAWK_SEED_LOCALE=en_US
DICOMHAWK_SEED_OSM_CITY=
DICOMHAWK_SEED_OSM_COUNTRY=
DICOMHAWK_SEED_HONEY_URL=https://example.com/honey
DICOMHAWK_SEED_CANARY_PDF=

# Values used only when setup.sh generates a custom profile from generic-pacs.
DICOMHAWK_CUSTOM_PROFILE_NAME=custom-pacs
DICOMHAWK_CUSTOM_IMPLEMENTATION_UID=1.2.826.0.1.3680043.9.3811.2.0.1
DICOMHAWK_CUSTOM_IMPLEMENTATION_VERSION=ORTHANC
DICOMHAWK_CUSTOM_MANUFACTURER=Orthanc
DICOMHAWK_CUSTOM_MODEL=Generic PACS
DICOMHAWK_CUSTOM_OPERATIONS=echo,find,get,move,store
DICOMHAWK_CUSTOM_MAX_ASSOCIATIONS=16
DICOMHAWK_CUSTOM_MAX_PDU_SIZE=65536
DICOMHAWK_CUSTOM_ACSE_TIMEOUT=10
DICOMHAWK_CUSTOM_NETWORK_TIMEOUT=15
DICOMHAWK_CUSTOM_DIMSE_TIMEOUT=20
DICOMHAWK_CUSTOM_MAX_STORE_BYTES=67108864
DICOMHAWK_CUSTOM_REQUIRE_CALLED_AET=false
DICOMHAWK_CUSTOM_REQUIRE_CALLING_AETS=
DICOMHAWK_CUSTOM_WEB_ENABLED=true
DICOMHAWK_CUSTOM_WEB_BROWSE=true
DICOMHAWK_CUSTOM_WEB_GRANT_ACCESS=keyword
DICOMHAWK_CUSTOM_WEB_SECURE_COOKIES=false
DICOMHAWK_CUSTOM_HONEY_USERNAME=test
DICOMHAWK_CUSTOM_HONEY_PASSWORD=test
DICOMHAWK_CUSTOM_HONEY_KEYWORDS=admin,pacs,dicom,radiology,imaging,service
DICOMHAWK_CUSTOM_WEB_SERVER=Apache
DICOMHAWK_CUSTOM_WEB_SITE_NAME=Generic PACS
DICOMHAWK_CUSTOM_WEB_VERSION=1.0
DICOMHAWK_CUSTOM_WEB_ROUTE_PREFIX=/portal
DICOMHAWK_CUSTOM_WEB_COOKIE_PREFIX=portal
DICOMHAWK_CUSTOM_WEB_MAX_REQUEST_BYTES=1048576
DICOMHAWK_CUSTOM_UPLOAD_MAX_REQUEST_BYTES=52428800
DICOMHAWK_CUSTOM_UPLOAD_MAX_FILES=10
DICOMHAWK_CUSTOM_PAGE_SIZE=100
DICOMHAWK_CUSTOM_FINGERPRINT_ENABLED=true
DICOMHAWK_CUSTOM_FINGERPRINT_SIGNALS=browser,rendering,math,screen,bot
DICOMHAWK_CUSTOM_DICOMWEB_ENABLED=true
DICOMHAWK_CUSTOM_DICOMWEB_SERVICES=qido,wado_rs,stow
DICOMHAWK_CUSTOM_DICOMWEB_PORT=8042
DICOMHAWK_CUSTOM_DICOMWEB_BASE_PATH=/dicom-web
DICOMHAWK_CUSTOM_DICOMWEB_REQUIRE_AUTH=
DICOMHAWK_CUSTOM_DICOMWEB_QIDO_MAX_RESULTS=20000
DICOMHAWK_CUSTOM_DICOMWEB_MAX_REQUEST_BYTES=67108864
DICOMHAWK_CUSTOM_DICOMWEB_MAX_STOW_PARTS=128
DICOMHAWK_CUSTOM_DICOMWEB_MEDIA_TYPE=application/dicom+json
DICOMHAWK_CUSTOM_DICOMWEB_TRANSFER_SYNTAX=1.2.840.10008.1.2.1
DICOMHAWK_CUSTOM_DICOMWEB_AUTH_SCHEMES=Basic

# Production bind-mount override inputs; traces must be a dedicated size-limited filesystem.
# DICOMHAWK_TRACES_HOST_PATH=/srv/dicomhawk-traces
# DICOMHAWK_STATE_HOST_PATH=/srv/dicomhawk-state
# DICOMHAWK_LOGS_HOST_PATH=/srv/dicomhawk-logs
# DICOMHAWK_TRACE_FILESYSTEM_MAX_BYTES=10737418240
