# DICOMHawk runtime configuration.

# AE Title the honeypot announces on associations.
DICOMHAWK_AE_TITLE=ORTHANC

# Primary DICOM listen port (typical pynetdicom default).
DICOMHAWK_PORT_PRIMARY=11112

# Secondary port mapped to container's privileged 104.
# Host-side 1104 avoids needing CAP_NET_BIND_SERVICE on the host.
DICOMHAWK_PORT_SECONDARY=1104
